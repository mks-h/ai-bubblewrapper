#!/usr/bin/env python3

import argparse
import os
from pathlib import Path
import shutil
import subprocess
import sys
from typing import cast


class Args:
    dry_run: bool
    command: str
    arguments: list[str]

    @staticmethod
    def parse_args():
        parser = argparse.ArgumentParser(
            prog="ai-bwrap",
            description="Uses bubblewrap utility to give your AI agent some safe space",
        )
        _ = parser.add_argument("-d", "--dry-run",
                                help="Log the command instead of running it", action="store_true")
        _ = parser.add_argument("command",
                                help="The command (agent) to run in sandbox")
        _ = parser.add_argument("arguments",
                                help="Arguments to the command (agent)",
                                nargs=argparse.REMAINDER, metavar="...")

        return parser.parse_args()

    def __init__(self):
        args = Args.parse_args()
        self.dry_run = cast(bool, args.dry_run)
        self.command = cast(str, args.command)
        self.arguments = cast(list[str], args.arguments)


def r(path: Path) -> str:
    return path.expanduser().absolute().as_posix()


class ConstrCmd():
    __args: list[str]

    def ro_bind(self, path: Path):
        self.__args.extend(("--ro-bind", r(path), r(path)))

    def rw_bind(self, path: Path):
        self.__args.extend(("--bind", r(path), r(path)))

    def dev(self, path: Path):
        self.__args.extend(("--dev", r(path)))

    def proc(self, path: Path):
        self.__args.extend(("--proc", r(path)))

    def tmpfs(self, path: Path):
        self.__args.extend(("--tmpfs", r(path)))

    def share_net(self):
        self.ro_bind(Path("/run/systemd/resolve/stub-resolv.conf"))
        self.__args.append("--share-net")

    def die_with_parent(self):
        self.__args.append("--die-with-parent")

    def construct(self, cmd: str, cmd_args: list[str]) -> list[str]:
        self.__args.append(cmd)
        self.__args.extend(cmd_args)
        return self.__args

    def __init__(self):
        cmd = shutil.which("bwrap")
        if not cmd:
            sys.exit(
                "Error: 'bwrap' executable is not found. Did you install bubblewrap?")
        self.__args = [cmd]


def prepare_agent_cmd(agent_cmd: str, agent_args: list[str]) -> list[str]:
    cmd = ConstrCmd()
    cmd.ro_bind(Path("/"))
    cmd.rw_bind(Path(os.getcwd()))
    cmd.dev(Path("/dev"))
    cmd.proc(Path("/proc"))
    cmd.tmpfs(Path("/run"))
    cmd.tmpfs(Path("/tmp"))
    cmd.share_net()
    cmd.die_with_parent()

    if (agent_cmd == "pi"):
        config_dir = Path(os.environ.get("PI_CODING_AGENT_DIR", "~/.pi"))
        cmd.rw_bind(config_dir)
    elif (agent_cmd == "opencode"):
        config_home = Path(os.environ.get("XDG_CONFIG_HOME", "~/.config"))
        config_dir = Path(os.environ.get("OPENCODE_CONFIG_DIR",
                                         config_home.joinpath("opencode")))
        data_dir = Path(os.environ.get("XDG_DATA_HOME",
                                       "~/.local/share")).joinpath("opencode")
        state_dir = Path(os.environ.get("XDG_STATE_HOME",
                                        "~/.local/state")).joinpath("opencode")
        cache_dir = Path(os.environ.get("XDG_CACHE_HOME",
                                        "~/.cache")).joinpath("opencode")
        cmd.rw_bind(config_dir)
        cmd.rw_bind(data_dir)
        cmd.rw_bind(state_dir)
        cmd.rw_bind(cache_dir)
    elif (agent_cmd == "codex"):
        config_dir = Path(os.environ.get("CODEX_HOME", '~/.codex'))
        cmd.rw_bind(config_dir)

    return cmd.construct(agent_cmd, agent_args)


def log_command(agent_cmd: list[str]):
    print(*agent_cmd)


def run_command(agent_cmd: list[str]):
    _ = subprocess.run(agent_cmd)


def main():
    args = Args()
    cmd = prepare_agent_cmd(args.command, args.arguments)
    if args.dry_run:
        log_command(cmd)
    else:
        run_command(cmd)


if __name__ == "__main__":
    main()
