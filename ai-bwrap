#!/usr/bin/env python3

import argparse
import os
from pathlib import Path
from typing import cast


class Args:
    command: str
    dry_run: bool

    @staticmethod
    def parse_args():
        parser = argparse.ArgumentParser(
            prog="ai-bwrap",
            description="Uses bubblewrap utility to give your AI agent some safe space",
        )
        _ = parser.add_argument(
            "command", help="The command (agent) ro run in sandbox")
        _ = parser.add_argument(
            "-d", "--dry-run", help="Log the command instead of running it", action="store_true")
        return parser.parse_args()

    def __init__(self):
        args = Args.parse_args()
        self.command = cast(str, args.command)
        self.dry_run = cast(bool, args.dry_run)


def r(path: Path) -> str:
    return path.expanduser().absolute().as_posix()


class ConstrCmd():
    user_cmd: str
    bwrap_args: list[str] = []

    def ro_bind(self, path: Path):
        self.bwrap_args.extend(("--ro-bind", r(path), r(path)))

    def rw_bind(self, path: Path):
        self.bwrap_args.extend(("--bind", r(path), r(path)))

    def dev(self, path: Path):
        self.bwrap_args.extend(("--dev", r(path)))

    def proc(self, path: Path):
        self.bwrap_args.extend(("--proc", r(path)))

    def tmpfs(self, path: Path):
        self.bwrap_args.extend(("--tmpfs", r(path)))

    def share_net(self):
        self.ro_bind(Path("/run/systemd/resolve/stub-resolv.conf"))
        self.bwrap_args.append("--share-net")

    def construct(self) -> list[str]:
        self.bwrap_args.append(self.user_cmd)
        return self.bwrap_args

    def __init__(self, cmd: str):
        self.user_cmd = cmd


def prepare_command(cmd: str) -> list[str]:
    bwrap_args = ConstrCmd(cmd)
    bwrap_args.ro_bind(Path("/"))
    bwrap_args.rw_bind(Path(os.getcwd()))
    bwrap_args.dev(Path("/dev"))
    bwrap_args.proc(Path("/proc"))
    bwrap_args.tmpfs(Path("/run"))
    bwrap_args.tmpfs(Path("/tmp"))
    bwrap_args.share_net()

    if (cmd == "pi"):
        config_dir = Path(os.environ.get("PI_CODING_AGENT_DIR", "~/.pi"))
        bwrap_args.rw_bind(config_dir)
    elif (cmd == "opencode"):
        config_home = Path(os.environ.get("XDG_CONFIG_HOME", "~/.config"))
        config_dir = Path(os.environ.get("OPENCODE_CONFIG_DIR",
                                         config_home.joinpath("opencode")))
        data_dir = Path(os.environ.get("XDG_DATA_HOME",
                                       "~/.local/share")).joinpath("opencode")
        state_dir = Path(os.environ.get("XDG_STATE_HOME",
                                        "~/.local/state")).joinpath("opencode")
        cache_dir = Path(os.environ.get("XDG_CACHE_HOME",
                                        "~/.cache")).joinpath("opencode")
        bwrap_args.rw_bind(config_dir)
        bwrap_args.rw_bind(data_dir)
        bwrap_args.rw_bind(state_dir)
        bwrap_args.rw_bind(cache_dir)
    elif (cmd == "codex"):
        config_dir = Path(os.environ.get("CODEX_HOME", '~/.codex'))
        bwrap_args.rw_bind(config_dir)

    return bwrap_args.construct()


def log_command(cmd: list[str]):
    print("bwrap", *cmd)


def run_command(cmd: list[str]):
    os.execvp("bwrap", ["bwrap", *cmd])


def main():
    args = Args()
    cmd = prepare_command(args.command)
    if args.dry_run:
        log_command(cmd)
    else:
        run_command(cmd)


if __name__ == "__main__":
    main()
