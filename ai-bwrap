#!/usr/bin/env python3

import argparse
import os
from pathlib import Path
import shutil
import subprocess
import sys
import tempfile
import time
from typing import cast


class Args:
    dry_run: bool
    command: str
    arguments: list[str]

    @staticmethod
    def parse_args():
        parser = argparse.ArgumentParser(
            prog="ai-bwrap",
            description="Uses bubblewrap utility to give your AI agent some safe space",
        )
        _ = parser.add_argument("-d", "--dry-run",
                                help="Log the command instead of running it", action="store_true")
        _ = parser.add_argument("command",
                                help="The command (agent) to run in sandbox")
        _ = parser.add_argument("arguments",
                                help="Arguments to the command (agent)",
                                nargs=argparse.REMAINDER, metavar="...")

        return parser.parse_args()

    def __init__(self):
        args = Args.parse_args()
        self.dry_run = cast(bool, args.dry_run)
        self.command = cast(str, args.command)
        self.arguments = cast(list[str], args.arguments)


def r(path: Path) -> str:
    return path.expanduser().absolute().as_posix()


class ConstrCmd():
    __args: list[str]

    def ro_bind(self, path: Path):
        self.__args.extend(("--ro-bind", r(path), r(path)))

    def rw_bind(self, path: Path, bind_path: Path | None = None):
        bind_path = bind_path if bind_path else path
        self.__args.extend(("--bind", r(path), r(bind_path)))

    def dev(self, path: Path):
        self.__args.extend(("--dev", r(path)))

    def proc(self, path: Path):
        self.__args.extend(("--proc", r(path)))

    def tmpfs(self, path: Path):
        self.__args.extend(("--tmpfs", r(path)))

    def share_net(self):
        self.ro_bind(Path("/run/systemd/resolve/stub-resolv.conf"))
        self.__args.append("--share-net")

    def die_with_parent(self):
        self.__args.append("--die-with-parent")

    def construct(self, cmd: str, cmd_args: list[str]) -> list[str]:
        self.__args.append(cmd)
        self.__args.extend(cmd_args)
        return self.__args

    def __init__(self):
        cmd = shutil.which("bwrap")
        if not cmd:
            sys.exit(
                "Error: 'bwrap' executable is not found. Did you install bubblewrap?")
        self.__args = [cmd]


def prepare_dbus_proxy_cmd() -> tuple[list[str], Path]:
    cmd = shutil.which("xdg-dbus-proxy")
    if not cmd:
        sys.exit(
            "Error: 'xdg-dbux-proxy' executable is not found.")

    xdg_runtime_dir = Path(os.environ.get(
        "XDG_RUNTIME_DIR", "/run/user/%s" % os.getuid()))
    host_bus = xdg_runtime_dir / "bus"
    proxy_bus = Path(tempfile.mkdtemp(dir=xdg_runtime_dir)) / "bus"

    return ([cmd, "unix:path=" + host_bus.as_posix(), proxy_bus.as_posix(), "--filter"], proxy_bus)


def prepare_agent_cmd(agent_cmd: str, agent_args: list[str], proxy_path: Path) -> list[str]:
    cmd = ConstrCmd()
    cmd.ro_bind(Path("/"))
    cmd.rw_bind(Path(os.getcwd()))
    cmd.dev(Path("/dev"))
    cmd.proc(Path("/proc"))
    cmd.tmpfs(Path("/run"))
    cmd.tmpfs(Path("/tmp"))
    cmd.share_net()
    cmd.die_with_parent()

    dbus_path = os.environ.get(
        "XDG_RUNTIME_DIR", "/run/user/%s" % os.getuid()) + "/bus"
    cmd.rw_bind(Path(proxy_path), Path(dbus_path))

    if (agent_cmd == "pi"):
        config_dir = Path(os.environ.get("PI_CODING_AGENT_DIR", "~/.pi"))
        cmd.rw_bind(config_dir)
    elif (agent_cmd == "opencode"):
        config_home = Path(os.environ.get("XDG_CONFIG_HOME", "~/.config"))
        config_dir = Path(os.environ.get("OPENCODE_CONFIG_DIR",
                                         config_home.joinpath("opencode")))
        data_dir = Path(os.environ.get("XDG_DATA_HOME",
                                       "~/.local/share")).joinpath("opencode")
        state_dir = Path(os.environ.get("XDG_STATE_HOME",
                                        "~/.local/state")).joinpath("opencode")
        cache_dir = Path(os.environ.get("XDG_CACHE_HOME",
                                        "~/.cache")).joinpath("opencode")
        cmd.rw_bind(config_dir)
        cmd.rw_bind(data_dir)
        cmd.rw_bind(state_dir)
        cmd.rw_bind(cache_dir)
    elif (agent_cmd == "codex"):
        config_dir = Path(os.environ.get("CODEX_HOME", '~/.codex'))
        cmd.rw_bind(config_dir)

    return cmd.construct(agent_cmd, agent_args)


def log_command(agent_cmd: list[str], dbus_cmd: list[str]):
    print(*dbus_cmd)
    print(*agent_cmd)


def run_command(agent_cmd: list[str], dbus_cmd: list[str], proxy_path: Path):
    proxy = subprocess.Popen(dbus_cmd)

    deadline = time.monotonic() + 1
    while not proxy_path.exists():
        if time.monotonic() >= deadline:
            raise TimeoutError("Timed out waiting for xdg-dbus-proxy")
        time.sleep(0.01)

    _ = subprocess.run(agent_cmd)
    proxy.terminate()


def main():
    args = Args()
    proxy_cmd, proxy_path = prepare_dbus_proxy_cmd()
    agent_cmd = prepare_agent_cmd(args.command, args.arguments, proxy_path)
    if args.dry_run:
        log_command(agent_cmd, proxy_cmd)
    else:
        run_command(agent_cmd, proxy_cmd, proxy_path)


if __name__ == "__main__":
    main()
